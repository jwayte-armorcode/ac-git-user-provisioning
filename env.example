# ArmorCode tenant
TENANT_URL=https://app.armorcode.com
API_TOKEN=your-armorcode-api-token

# GitHub (Personal Access Token — needs repo, read:org, read:user scopes)
GITHUB_PAT=ghp_your_token_here
# Optional: comma-separated list of repos to restrict to (owner/repo format)
# GITHUB_REPOS=myorg/repo1,myorg/repo2

# GitLab (Personal Access Token — needs read_api, read_user scopes)
GITLAB_PAT=glpat-your_token_here
GITLAB_URL=https://gitlab.com
# Optional: comma-separated list of project IDs or paths to restrict to
# GITLAB_PROJECTS=mygroup/repo1,mygroup/repo2

# Sync mode: dry_run (print only) or apply (write to ArmorCode)
SYNC_MODE=dry_run
