# ArmorCode tenant (required — no default; an unset TENANT_URL is a hard error)
TENANT_URL=https://xxxx.armorcode.xxx
API_TOKEN=your-armorcode-api-token

# GitHub (Personal Access Token — needs repo, read:org, read:user scopes)
GITHUB_PAT=ghp_your_token_here

# GitLab (Personal Access Token — needs read_api, read_user scopes)
GITLAB_PAT=glpat-your_token_here
GITLAB_URL=https://gitlab.com
