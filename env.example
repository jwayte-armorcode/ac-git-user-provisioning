# Copy this to `envfile` and fill it in. `envfile` is gitignored; this
# template is not, so never put a real token here.
#
# One file holds everything: the ArmorCode tenant, every SCM, and the safety
# thresholds for reconciliation.

[armorcode]
# Host only — no scheme. There is no default: an unset url is a hard error
# rather than a run against a tenant you didn't intend.
url = xxxx.armorcode.xxx
token = your-armorcode-api-token

# tenantRole given to users this tool creates. Must exist in the tenant
# (validated at startup) and is case-sensitive: "Developer", not "developer".
default_role = Developer


# ---------------------------------------------------------------------------
# SCMs — one [scm.<mnemonic>] section each, as many as you need.
#
# The mnemonic after "scm." names the SCM on the command line
# (extract.py --scm gh-main) and is also the directory its extract is written
# to, so it must be a filesystem-safe token: letters, digits, dot, dash,
# underscore.
# ---------------------------------------------------------------------------

[scm.gh-main]
type = github
# Omit for github.com. For GitHub Enterprise give the API root,
# e.g. https://github.example.com/api/v3
# url = https://api.github.com
# Needs: repo, read:org, read:user
token = ghp_your_token_here

[scm.gitlab-prod]
type = gitlab
url = https://gitlab.com
# Needs: read_api, read_user
token = glpat-your_token_here

# A second GitHub org, a self-hosted GitLab, a staging instance — just add
# another section. Provisioning always reads EVERY configured SCM, because a
# team's membership is the union across all of them.
#
# [scm.gh-acme]
# type = github
# token = ghp_...


# ---------------------------------------------------------------------------
# Reconciliation safety limits (reconcile.py only)
#
# The circuit breaker that stops a bad extract becoming a mass removal — see
# the README. Any key may be omitted; the values below are the defaults.
# ---------------------------------------------------------------------------

[reconcile]
# Per-team: skip the team if removals exceed this percentage of its members.
max_removal_pct = 25

# ...but never trip at or below this many removals, so a 3-person team losing
# 1 (33%) isn't treated as a mass removal.
max_removal_floor = 5

# Whole-run: if more than this many teams trip the per-team check, abort
# everything. One team over the line is plausible attrition; several at once
# means the input is wrong.
max_tripped_teams = 3


# ---------------------------------------------------------------------------
# Snapshots — taken before every write, so restore.py has something to
# rebuild from. They contain member names and emails, and are gitignored.
# ---------------------------------------------------------------------------

[snapshots]
dir = snapshots
# 0 disables pruning. The newest snapshot is never pruned regardless of age.
snapshot_retention_days = 90
